{
  "name": "hardware-tracker",
  "productName": "Hardware Tracker",
  "version": "0.9.5",
  "description": "PC gaming hardware news, price trends and daily/weekly recaps (GPU, CPU, RAM).",
  "author": "Hardware Tracker",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:win-zip": "npm run build && electron-builder --win zip --x64 --publish never",
    "release-notes": "node tools/release-notes.cjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "android": "npm run build && cap sync android"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "dompurify": "3.5.0",
    "electron-updater": "6.8.11",
    "html-to-image": "^1.11.11",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "build": {
    "appId": "app.hardwaretracker.desktop",
    "productName": "Hardware Tracker",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-1024.png",
      "category": "Utility",
      "maintainer": "TASTTYCHEESE <noreply@github.com>",
      "synopsis": "PC hardware news, prices and specs",
      "artifactName": "HardwareTracker-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "HardwareTracker-Setup-${version}.${ext}",
      "shortcutName": "Hardware Tracker"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TASTTYCHEESE",
        "repo": "Hardware-Tracker",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "build/release-notes.md"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-1024.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "HardwareTracker-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "HardwareTracker-${version}-mac-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TASTTYCHEESE/Hardware-Tracker.git"
  },
  "desktopName": "hardware-tracker.desktop"
}
