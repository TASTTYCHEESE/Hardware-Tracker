{
  "appId": "app.hardwaretracker.mobile",
  "appName": "Hardware Tracker",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "BackgroundRunner": {
      "label": "app.hardwaretracker.mobile.check",
      "src": "runners/background.js",
      "event": "checkForUpdates",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}
